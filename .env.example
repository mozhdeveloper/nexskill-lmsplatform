# Supabase project (Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for admin operations (seed script, certificate issuance job).
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used to build verification/QR links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Integration adapters (all optional in P0; features degrade gracefully without them) ---
# VideoProvider (P1)
VIDEO_PROVIDER_API_KEY=
# PaymentProvider (P1)
PAYMENT_PROVIDER_SECRET_KEY=
# EmailProvider (P1) — P0 logs emails to the server console instead
EMAIL_PROVIDER_API_KEY=
# LiveMeetingProvider (P1) — Google Workspace service account for live@nexskill.com
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=
# AIProvider (P2)
ANTHROPIC_API_KEY=
# CertificateAnchorProvider (P1) — unset uses the no-op adapter (status stays "unanchored")
CERT_ANCHOR_PROVIDER_API_KEY=
